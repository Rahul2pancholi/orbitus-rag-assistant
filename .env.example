# ---- Local mode (default): no AWS needed ----
EMBEDDINGS_PROVIDER=local        # local (fastembed, BAAI/bge-small-en-v1.5) | bedrock (Titan v2)
LLM_PROVIDER=ollama              # ollama (local model) | extractive (no LLM) | bedrock (Claude via Converse)
LLM_MODEL_ID=qwen2.5:3b          # ollama pull qwen2.5:3b
STORE_URI=.data                  # local dir, or s3://<bucket> for AWS
TENANT_ID=demo

# ---- AWS mode: uncomment once Bedrock/S3 access is available ----
# EMBEDDINGS_PROVIDER=bedrock
# LLM_PROVIDER=bedrock
# LLM_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# STORE_URI=s3://<DocsBucketName from cdk deploy output>
# AWS_REGION=us-east-2
# AWS_PROFILE=default
# EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ---- Hosted LLM (what the AWS Free-plan deployment uses) ----
# LLM_PROVIDER=groq
# LLM_MODEL_ID=openai/gpt-oss-120b
# GROQ_API_KEY_PARAM=/orbitus/groq-api-key   # read from SSM Parameter Store (SecureString)
# GROQ_API_KEY=...                           # or set directly for local runs; never commit it

# ---- Tuning (optional) ----
# TOP_K=5
# MIN_SCORE=0.5                  # per-model default; see app/config.py
# CHUNK_SIZE=600
# CHUNK_OVERLAP=120
# LLM_TIMEOUT_S=120             # 30 for bedrock
# OLLAMA_URL=http://localhost:11434
